# Network this build is for. Switches the entire UI palette
# (azure for mainnet, amber for testnet) and the AppBar identity.
NEXT_PUBLIC_NETWORK=testnet

# Backend base URLs.
# CLIENT-side: visible to the browser, used by all in-page fetches.
# Behind nginx this is the public origin (e.g. https://explorer.gridcoin.club/api).
NEXT_PUBLIC_API_URL=http://localhost:7002

# SERVER-side: used during SSR / getServerSideProps.
# Inside Docker this is typically the internal service name
# (http://grc_explorer:7002), not the public URL.
NEXT_PUBLIC_API_URL_SERVER=http://localhost:7002

# Plausible analytics on/off.
NEXT_PUBLIC_TRACK=false

# Opt out of Next.js telemetry (https://nextjs.org/telemetry).
# Mirrors the same flag in Dockerfile so prod builds and local dev agree.
NEXT_TELEMETRY_DISABLED=1
