# Build stage
FROM node:22.16.0 AS builder

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build

# Production stage
FROM node:22.16.0

LABEL maintainer="grc-explorer Project"
LABEL description="Production environment for grc-explorer backend service"

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci --only=production
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/clickhouse ./clickhouse

RUN addgroup --system appgroup && adduser --system --ingroup appgroup appuser && \
    chown -R appuser:appgroup /usr/src/app
USER appuser

EXPOSE 7002

HEALTHCHECK --interval=30s --timeout=3s \
  CMD wget --no-verbose --tries=1 --spider http://localhost:7002/status || exit 1

ENV NODE_ENV=production

# `npm start` automatically fires the `prestart` hook which runs
# `node clickhouse/migrate.mjs` — the ClickHouse migrations are
# idempotent, so re-run on every container start is safe and ensures
# fresh deploys never serve traffic against an out-of-date schema.
CMD ["npm", "start"]
